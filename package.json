{
  "name": "alexandre-kryshen-climatisation",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://maxitoon.github.io/alexandre-kryshen-climatisation/",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/validate-build.mjs",
    "build:pages": "PUBLIC_SITE_ORIGIN=https://maxitoon.github.io PUBLIC_BASE_PATH=/alexandre-kryshen-climatisation npm run build",
    "build:e2e": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_URL=http://127.0.0.1:4321 PUBLIC_QUOTE_ENDPOINT=/api/quote PUBLIC_CONTACT_PHONE=+33000000000 PUBLIC_WHATSAPP_NUMBER=33000000000 astro build --outDir .tmp/e2e-dist && DIST_ROOT=.tmp/e2e-dist ALLOW_TEST_CONTACTS=1 node scripts/validate-build.mjs",
    "build:lighthouse": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_ORIGIN=https://preview.invalid astro build --outDir .tmp/lighthouse-dist && DIST_ROOT=.tmp/lighthouse-dist node scripts/validate-build.mjs",
    "preview": "node scripts/preview-server.mjs",
    "preview:e2e": "DIST_ROOT=.tmp/e2e-dist node scripts/preview-server.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "prettier --check . && eslint scripts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "npm run build:lighthouse && lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/onest": "5.3.0",
    "astro": "7.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
